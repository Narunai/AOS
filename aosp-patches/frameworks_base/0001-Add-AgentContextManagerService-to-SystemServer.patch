From: AgentOS Team <dev@agentos.org>
Subject: [PATCH 1/3] SystemServer: Register AgentContextManagerService on boot

Registers the AgentContextManagerService in startOtherServices() to expose
android.app.agent.AgentManager and the Agent Context Bus Binder interface.

---
 services/java/com/android/server/SystemServer.java | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/services/java/com/android/server/SystemServer.java b/services/java/com/android/server/SystemServer.java
--- a/services/java/com/android/server/SystemServer.java
+++ b/services/java/com/android/server/SystemServer.java
@@ -104,6 +104,7 @@ import com.android.server.am.ActivityManagerService;
 import com.android.server.wm.ActivityTaskManagerService;
 import com.android.server.wm.WindowManagerService;
+import com.android.server.agent.AgentContextManagerService;
 
 public final class SystemServer implements Dumpable {
@@ -2850,6 +2851,14 @@ public final class SystemServer implements Dumpable {
         }
         t.traceEnd();
 
+        // AgentOS Context Bus Service
+        t.traceBegin("StartAgentContextManagerService");
+        try {
+            mSystemServiceManager.startService(AgentContextManagerService.class);
+        } catch (Throwable e) {
+            reportWtf("starting AgentContextManagerService", e);
+        }
+        t.traceEnd();
+
         t.traceBegin("MakeContextManagerReady");
         try {
             contextManager.systemReady();
-- 
